+	auto c = std::toupper(str[str.size() - 1]);
+	// 'D' completing a 'BD' pair — the 'B' was already validated on the previous call.
+	if (c == 'D' && std::toupper(str[str.size() - 2]) == 'B') {
+		return true;
+	}
+	return SparkCompatUtils::IsSparkPostfixToken(&str[str.size() - 1]);
+}
